# Nexus Forge — example environment.
# Copy to .env and fill in only for local development.
# The offline plan-ledger core needs NO LLM or IdP configuration.

# --- App ---
NEXUS_ENV=dev            # "dev" enables the opt-in local demo mode; "production" refuses demo.
NEXUS_DEMO=1             # Enable local-only demo mode (NEXUS_ENV must be "dev").
NEXUS_DB_PATH=./backend/app/data/ledger.sqlite   # SQLite ledger path.

# --- Optional LLM providers (future milestone: advisory explanations) ---
LLM_API_KEY=             # The ONLY LLM credential variable. Leave blank for offline mode.
LLM_PROVIDER=            # openai-compatible | anthropic | gemini | ollama  (default openai-compatible)
LLM_MODEL=               # model name (no build-agent/model preset)
LLM_BASE_URL=            # operator-configured endpoint only

# --- Optional SSO (future milestone: auth-oidc) ---
OIDC_ISSUER=             # e.g. https://keycloak.example/realms/...
OIDC_CLIENT_ID=
OIDC_REALM=              # Keycloak realm import path